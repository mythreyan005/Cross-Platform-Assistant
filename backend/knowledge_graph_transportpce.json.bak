    {
      "id": "commit:e10ac2a",
      "node_type": "commit",
      "label": "Commit e10ac2a",
      "sha": "e10ac2a07e5e60327b5dcb769b9aacfa8ebd7106",
      "short_sha": "e10ac2a",
      "author": "Joakim T\u00f6rnqvist",
      "title": "Commit e10ac2a: TAPI - Share default transfer characteristics",
      "message": "GitHub Commit e10ac2a by Joakim T\u00f6rnqvist (2026-09-10T08:11:58+00:00)\nRepository: opendaylight/transportpce\nMessage: TAPI - Share default transfer characteristics\n\nCentralize the placeholder cost, latency, and risk characteristics used\nby TAPI topology builders. Reuse one immutable instance instead of\nrebuilding identical values at each call site.\n\nJIRA: TRNSPRTPCE-980\nChange-Id: Ifd44fd48b8c4cdf3c0be63070ca5f7e17d72257c\nSigned-off-by: Joakim T\u00f6rnqvist <joakim.tornqvist@smartoptics.com>\nLinked Jira Issues: TRNSPRTPCE-980\nModified Files: tapi/src/main/java/org/opendaylight/transportpce/tapi/impl/rpc/GetTopologyDetailsImpl.java, tapi/src/main/java/org/opendaylight/transportpce/tapi/topology/ORtoTapiTopoConversionTools.java, tapi/src/main/java/org/opendaylight/transportpce/tapi/topology/TapiNetworkModelServiceImpl.java, tapi/src/main/java/org/opendaylight/transportpce/tapi/utils/TapiDefaultTransferCharacteristics.java, tapi/src/main/java/org/opendaylight/transportpce/tapi/utils/TapiLinkImpl.java",
      "timestamp": "2026-09-10T08:11:58+00:00",
      "url": "https://github.com/opendaylight/transportpce/commit/e10ac2a07e5e60327b5dcb769b9aacfa8ebd7106",
      "project_id": "opendaylight/transportpce"
    },
    {
      "id": "commit:2e7e995",
      "node_type": "commit",
      "label": "Commit 2e7e995",
      "sha": "2e7e99507302840e459b0f38388a2b1de307ceb9",
      "short_sha": "2e7e995",
      "author": "Joakim T\u00f6rnqvist",
      "title": "Commit 2e7e995: TAPI - Consolidate topology datastore writes",
      "message": "GitHub Commit 2e7e995 by Joakim T\u00f6rnqvist (2026-08-14T10:15:01+00:00)\nRepository: opendaylight/transportpce\nMessage: TAPI - Consolidate topology datastore writes\n\nShare topology merge-target construction between node and link writers,\nand centralize link merge and commit handling.\n\nLog link-write success only after a successful commit and include\nlink names when reporting failures.\n\nJIRA: TRNSPRTPCE-979\nChange-Id: Icab8912cb3ba0a3195c933e2b8d13d50bfc9bbd6\nSigned-off-by: Joakim T\u00f6rnqvist <joakim.tornqvist@smartoptics.com>\nLinked Jira Issues: TRNSPRTPCE-979\nModified Files: tapi/src/main/java/org/opendaylight/transportpce/tapi/listeners/topology/TapiOrLinkListener.java, tapi/src/main/java/org/opendaylight/transportpce/tapi/topology/TapiLinkTopologyWriter.java, tapi/src/main/java/org/opendaylight/transportpce/tapi/topology/TapiNetworkModelServiceImpl.java, tapi/src/test/java/org/opendaylight/transportpce/tapi/topology/TapiLinkTopologyWriterTest.java",
      "timestamp": "2026-08-14T10:15:01+00:00",
      "url": "https://github.com/opendaylight/transportpce/commit/2e7e99507302840e459b0f38388a2b1de307ceb9",
      "project_id": "opendaylight/transportpce"
    },
    {
